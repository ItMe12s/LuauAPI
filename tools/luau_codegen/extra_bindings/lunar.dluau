export type LunarNodePose = {
    x: number?,
    y: number?,
    rot: number?,
    sx: number?,
    sy: number?,
    opacity: number?,
    z: number?,
    ax: number?,
    ay: number?,
    skx: number?,
    sky: number?,
    easing: string?,
}

export type LunarRigNodeSpec = {
    id: string,
    sprite: string?,
    parent: string?,
    x: number?,
    y: number?,
    rot: number?,
    sx: number?,
    sy: number?,
    z: number?,
    opacity: number?,
    ax: number?,
    ay: number?,
    skx: number?,
    sky: number?,
}

export type LunarRigSpec = {
    nodes: { LunarRigNodeSpec },
}

export type LunarKeyframeEntry = {
    events: (string | { string })?,
    [string]: LunarNodePose,
}

export type LunarAnimationDefTable = {
    fps: number?,
    looped: boolean?,
    keyframes: { [number]: LunarKeyframeEntry },
}

declare class LunarAnimationDef
    function setFps(self, fps: number): ()
    function getFps(self): number
    function setLooped(self, looped: boolean): ()
    function getLooped(self): boolean
    function addKeyframe(self, frame: number, nodeId: string, pose: LunarNodePose): ()
    function addEvent(self, frame: number, name: string): ()
    function listKeyframes(self): { { frame: number, targets: { [string]: LunarNodePose }, events: { string } } }
    function getKeyAt(self, frame: number): ({ targets: { [string]: LunarNodePose }, events: { string } })?
    function removeKeyframe(self, frame: number): boolean
    function moveKeyframe(self, from: number, to: number): boolean
end

declare class LunarRig extends CCNode
    function load(self, spec: LunarRigSpec): (LunarRig?, string?)
    function add(self, node: CCNode, id: string?): ()
    function addTo(self, parentId: string, node: CCNode, id: string?): ()
    function getNode(self, id: string): CCNode?
    function listNodes(self): { string }
    function getPose(self, id: string): LunarNodePose?
    function loadAnimation(self, anim: LunarAnimationDef | LunarAnimationDefTable): (LunarAnimationTrack?, string?)
end

declare class LunarAnimationTrack
    function play(self): ()
    function pause(self): ()
    function unpause(self): ()
    function stop(self): ()
    function setSpeed(self, speed: number): ()
    function isPlaying(self): boolean
    function isPaused(self): boolean
    function speed(self): number
    function duration(self): number
    function sample(self, t: number): { [string]: LunarNodePose }
    function seek(self, t: number): ()
    function currentTime(self): number
    function bindEvent(self, name: string, callback: (eventName: string) -> ()): ()
end

declare lunar: {
    rig: {
        new: () -> LunarRig,
    },
    animation: {
        new: () -> LunarAnimationDef,
        load: (def: LunarAnimationDefTable) -> (LunarAnimationDef?, string?),
    },
}
